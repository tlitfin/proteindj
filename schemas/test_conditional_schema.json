{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/PapenfussLab/proteindj/master/schemas/test_conditional_schema.json",
  "title": "ProteinDJ conditional schema test",
  "description": "Minimal schema to test whether Seqera Platform's launch form honours allOf/if-then conditional 'required' rules based on a sibling property (design_mode).",
  "type": "object",
  "definitions": {
    "essential_parameters": {
      "title": "Essential Parameters",
      "type": "object",
      "description": "Core parameters required for every mode.",
      "properties": {
        "design_mode": {
          "type": "string",
          "description": "Pipeline mode.",
          "enum": [
            "bindcraft_denovo",
            "boltzgen_denovo",
            "boltzgen_redesign",
            "rfd_denovo",
            "rfd_foldcond",
            "rfd_motifscaff",
            "rfd_partialdiff"
          ]
        },
        "num_designs": {
          "type": "integer",
          "default": 8,
          "description": "Number of designs to generate."
        },
        "out_dir": {
          "type": "string",
          "default": "${projectDir}/pdj_results",
          "format": "directory-path",
          "description": "Output directory for results."
        }
      },
      "required": [
        "design_mode",
        "num_designs",
        "out_dir"
      ]
    },
    "mode_specific_parameters": {
      "title": "Mode-Specific Parameters",
      "type": "object",
      "description": "Whether each of these is required depends on design_mode - see the conditional 'allOf' rules below.",
      "properties": {
        "design_length": {
          "type": "string",
          "pattern": "^\\d+(-\\d+)?$",
          "description": "Design length e.g. '60' or '60-70'. Required for rfd_denovo, bindcraft_denovo, boltzgen_denovo."
        },
        "input_pdb": {
          "type": "string",
          "format": "file-path",
          "pattern": ".*\\.pdb$",
          "description": "Path to an input PDB file. Required for bindcraft_denovo, boltzgen_denovo, boltzgen_redesign, rfd_motifscaff, rfd_partialdiff."
        },
        "rfd_contigs": {
          "type": "string",
          "pattern": "^\\[[A-Z0-9\\-\\/ \\[\\]]+\\]$",
          "description": "Contigs specification string. Required for rfd_motifscaff."
        },
        "rfd_scaffold_dir": {
          "type": "string",
          "format": "directory-path",
          "description": "Path to directory containing scaffold files. Required for rfd_foldcond."
        },
        "rfd_partial_diffusion_timesteps": {
          "type": "integer",
          "description": "Number of timesteps for partial diffusion. Required for rfd_partialdiff."
        }
      }
    }
  },
  "allOf": [
    {
      "$ref": "#/definitions/essential_parameters"
    },
    {
      "$ref": "#/definitions/mode_specific_parameters"
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "rfd_denovo" } }
      },
      "then": { "required": ["design_length"] }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "rfd_foldcond" } }
      },
      "then": { "required": ["rfd_scaffold_dir"] }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "rfd_motifscaff" } }
      },
      "then": { "required": ["input_pdb", "rfd_contigs"] }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "rfd_partialdiff" } }
      },
      "then": { "required": ["input_pdb", "rfd_partial_diffusion_timesteps"] }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "bindcraft_denovo" } }
      },
      "then": { "required": ["input_pdb", "design_length"] }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "boltzgen_denovo" } }
      },
      "then": { "required": ["input_pdb", "design_length"] }
    },
    {
      "if": {
        "required": ["design_mode"],
        "properties": { "design_mode": { "const": "boltzgen_redesign" } }
      },
      "then": { "required": ["input_pdb"] }
    }
  ]
}

config {

    testsDir "tests"
    workDir ".nf-test"
    configFile "tests/nextflow.config"
    profile ""
    // Also expose the project's own lib/ classes (DesignEngine, Utils, etc.) to code written
    // directly in test 'then'/'when' blocks - Nextflow auto-adds this for the generated mock
    // scripts already, but nf-test's own Groovy shell needs it declared explicitly here.
    libDir "lib"

}

Bootstrap: docker
From: ubuntu:24.04

%post
    # install deps
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        python3-venv \
        python3-pip \
        python3-dev \
        wget \
        unzip \
        git \
        procps \
        coreutils \
        grep \
        pigz \
        sed \
        dssp \
        curl \
        build-essential

    # create and activate virtual environment
    python3 -m venv /opt/venv
    . /opt/venv/bin/activate

    # install python tools
    export PIP_NO_CACHE_DIR=1
    pip install uv
    export UV_NO_CACHE=1
    export UV_LINK_MODE=copy
    uv pip install \
        arpeggia \
        biopython \
        matplotlib \
        pandas \
        pdbfixer \
        pyfaspr \
        prodigy-prot \
        pyyaml
    uv pip install \
        torch \
        torchvision --index-url https://download.pytorch.org/whl/cpu

    # cleanup build dependencies
    apt-get autoremove -y
    apt-get clean
    
    # link venv
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

%runscript
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%help
    Container with Arpeggia, BioPython, Matplotlib, Pandas, PDBFixer, PRODIGY, PyTorch (CPU), PyYAML and DSSP (mkdssp) installed in a Python virtual environment.
    To use, run the container and your environment will be activated automatically.

%labels
    Author JoshuaHardy, DavidLadd
    Version 3.0
Bootstrap: docker
From: ubuntu:24.04

%post
    # install deps
    apt-get -q update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        python3-venv \
        python3-pip \
        wget \
        unzip \
        git \
        procps \
        coreutils \
        grep \
        pigz \
        sed \
        dssp \
        curl \
        build-essential

    # create and activate virtual environment
    python3 -m venv /opt/venv
    . /opt/venv/bin/activate

    # install python tools
    export PIP_NO_CACHE_DIR=1
    pip install uv
    export UV_NO_CACHE=1
    export UV_LINK_MODE=copy
    uv pip install \
        biopython \
        biotite \
        matplotlib \
        pandas \
        pdbfixer \
        pyfaspr \
        prodigy-prot \
        pyyaml
    uv pip install \
        torch \
        torchvision --index-url https://download.pytorch.org/whl/cpu

    # Install sc-rs (shape complementarity binary) via rustup
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
    . "$HOME/.cargo/env"
    cargo install --git https://github.com/cytokineking/sc-rs --tag v1.0.0 --root /usr/local
    rustup self uninstall -y

    # cleanup build dependencies
    apt-get autoremove -y
    apt-get clean
    
    # link venv
    echo '. /opt/venv/bin/activate' >> $APPTAINER_ENVIRONMENT

%runscript
    if [ $# -eq 0 ]; then
        exec /bin/bash --norc
    else
        exec "$@"
    fi

%help
    Container with BioPython, Biotite, Matplotlib, Pandas, PDBFixer, PyTorch (CPU), PyYAML, and DSSP (mkdssp) installed in a Python virtual environment.
    To use, run the container and your environment will be activated automatically.

%labels
    Author JoshuaHardy
    Version 3.0
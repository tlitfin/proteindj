Bootstrap: docker
From: nvidia/cuda:12.6.3-runtime-ubuntu24.04

%post
    apt-get update
    DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends -y \
        build-essential \
        ca-certificates \
        libxext6 \
        libxrender1 \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv
    python3 -m venv /opt/rfd4
    /opt/rfd4/bin/pip install --no-cache-dir 'rfd4-proteina[all-cuda12]'
    apt-get clean

%environment
    export PATH=/opt/rfd4/bin:$PATH

%test
    /opt/rfd4/bin/rfd4-generate --help >/dev/null
